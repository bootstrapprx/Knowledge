    <dc:identifier id="bookid">urn:uuid:40181f01-22a7-4582-9847-8948879a47d0</dc:identifier>
    <dc:title>Inteligência Artificial e Ciência de Dados para Concursos Públicos</dc:title>
    <dc:creator id="autor">Tom</dc:creator>
    <dc:language>pt-BR</dc:language>
    <dc:subject>Concursos públicos</dc:subject>
    <dc:subject>Inteligência artificial</dc:subject>
    <dc:subject>Ciência de dados</dc:subject>
    <dc:description>Livro unificado (Fase 1 concluída): esqueleto de 18 capítulos no template de produção — procedência .proc (banca/ano/órgão/cargo), gabarito oficial, comentário em 5 blocos fixos, âncoras bidirecionais q-CC-n / c-CC-n com 144 questões pendentes de fonte validada. Meta global: ≈103.000 palavras (≥300 páginas no PDF de conferência).</dc:description>
